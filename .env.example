# SECRET_KEY 留空则由系统自动生成并持久化到 data/.secret_key，容器重启后自动复用
# 如需自定义固定密钥，请取消注释并设置
# SECRET_KEY=your-custom-secret-key-min-32-chars

# ENCRYPTION_KEY 可不设置，首次启动会自动生成并持久化到 data/.encryption_key
# ENCRYPTION_KEY=your-custom-encryption-key

DATABASE_URL=sqlite:///./data/seat.db
DEBUG=false

# Redis 频率限制（可选，不设置则使用内存模式）
# REDIS_URL=redis://localhost:6379/0

# 教师初始化令牌：首次设置教师密码时需要的令牌，防止未授权初始化
# 部署时必须设置此值，否则初始化接口将拒绝所有请求
TEACHER_INIT_TOKEN=change-me-to-a-random-secret

# API 速率限制：每窗口期内允许的最大请求数，默认 200次/60秒
# API_RATE_LIMIT=200
# API_RATE_WINDOW=60